PORT=4173
ACCESS_CODE=CRS-ANGELA-TEST
ELEVENLABS_AGENT_ID=agent_9801m624gaj7enj9hj7zd11bqya5
ELEVENLABS_API_KEY=
ADMIN_KEY=change-me

# Avatar provider: talking-avatar-oss (default, free) or heygen (HeyGen LiveAvatar / Interactive)
AVATAR_PROVIDER=talking-avatar-oss
# HeyGen LiveAvatar (liveavatar.com) — MUST be from https://app.liveavatar.com/developers
# Classic HeyGen keys from app.heygen.com will return Invalid API key on api.liveavatar.com
LIVEAVATAR_API_KEY=
# alias also accepted (discouraged): HEYGEN_API_KEY=
# Optional sandbox (no credits, Wayne avatar only, ~1 min): LIVEAVATAR_SANDBOX=true
LIVEAVATAR_AVATAR_ID=
# alias: HEYGEN_AVATAR_ID=
# Optional: pre-registered LiveAvatar secret for the ElevenLabs API key
LIVEAVATAR_ELEVENLABS_SECRET_ID=
# alias: HEYGEN_ELEVENLABS_SECRET_ID=
# If secret id is empty but ELEVENLABS_API_KEY is set, the server registers it once at runtime.

# Interview recording (optional). Without these, interviews still work; recording APIs return storage_not_configured.
SUPABASE_URL=
# Service role key — paste in Render only; never commit. Shown once in Supabase Project Settings → API.
SUPABASE_SERVICE_ROLE_KEY=

